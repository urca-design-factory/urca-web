{
  "name": "urca-web-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "lint": "eslint .",
    "sigils:generate": "node scripts/generate-factory-sigils.mjs",
    "test": "node --test components/hero-artwork.test.ts components/factory-sigil-states.test.ts components/brief-questions.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "test:site": "node scripts/check-site.mjs",
    "db:migrate:local": "wrangler d1 migrations apply urca-briefs --local",
    "db:migrate:remote": "wrangler d1 migrations apply urca-briefs --remote",
    "briefs": "node scripts/briefs.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "lenis": "^1.3.26",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "playwright": "^1.63.0",
    "typescript": "^5",
    "wrangler": "^4.131.2"
  }
}
